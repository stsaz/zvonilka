From 7dd2dca583e4e3ff6d18eacb7566eb7ff1b8d6c5 Mon Sep 17 00:00:00 2001
From: Simon Zolin <4729655+stsaz@users.noreply.github.com>
Date: Thu, 19 Sep 2024 07:56:53 +0300
Subject: [PATCH] patch phiola for zvonilka

---
 src/adev/Makefile    | 2 +-
 src/afilter/Makefile | 4 ++--
 src/core/meta.h      | 6 +++---
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/adev/Makefile b/src/adev/Makefile
index 683cf54..e97130d 100644
--- a/src/adev/Makefile
+++ b/src/adev/Makefile
@@ -28,7 +28,7 @@ ifneq "$(A_API)" "21"
 	MODS += aaudio.$(SO)
 endif
 else ifeq "$(OS)" "linux"
-	MODS += alsa.$(SO) pulse.$(SO) jack.$(SO)
+	MODS += alsa.$(SO) pulse.$(SO) # jack.$(SO)
 endif
 
 %.o: $(PHIOLA)/src/adev/%.c
diff --git a/src/afilter/Makefile b/src/afilter/Makefile
index 41d98b8..8a6623c 100644
--- a/src/afilter/Makefile
+++ b/src/afilter/Makefile
@@ -45,8 +45,8 @@ soxr-conv.o: $(PHIOLA)/src/afilter/soxr-conv.c
 $(AFPFX)soxr.$(SO): soxr-conv.o
 	$(LINK) -shared $+ $(LINKFLAGS) $(LINK_RPATH_ORIGIN) -L$(ALIB3_BIN) -lsoxr-phi -o $@
 
-MODS += $(AFPFX)danorm.$(SO)
-LIBS3 += $(ALIB3_BIN)/libDynamicAudioNormalizer-phi.$(SO)
+# MODS += $(AFPFX)danorm.$(SO)
+# LIBS3 += $(ALIB3_BIN)/libDynamicAudioNormalizer-phi.$(SO)
 dynanorm.o: $(PHIOLA)/src/afilter/dynanorm.c
 	$(C) $(CFLAGS) -I$(ALIB3) $< -o $@
 $(AFPFX)danorm.$(SO): dynanorm.o
diff --git a/src/core/meta.h b/src/core/meta.h
index eaf651c..15dd2ef 100644
--- a/src/core/meta.h
+++ b/src/core/meta.h
@@ -28,7 +28,7 @@ static void meta_destroy(phi_meta *meta)
 static void meta_set(phi_meta *meta, ffstr name, ffstr val, uint flags)
 {
 	struct _phi_meta *m = *meta;
-	dbglog("meta: %S = %S", &name, &val);
+	// dbglog("meta: %S = %S", &name, &val);
 	if (!name.len) return;
 	uint n = 0, cap = 0;
 	char *s;
@@ -58,7 +58,7 @@ static void meta_set(phi_meta *meta, ffstr name, ffstr val, uint flags)
 		if (n + 2 > m->cap)
 			cap = n + ffmax(2, n / 2);
 		if (ff_unlikely(cap > 0xff)) {
-			errlog("meta tags limit reached");
+			// errlog("meta tags limit reached");
 			return;
 		}
 	}
@@ -149,7 +149,7 @@ static int meta_find(const phi_meta *meta, ffstr name, ffstr *val, uint flags)
 	ffstr n, v;
 	while (meta_list(meta, &i, &n, &v, flags)) {
 		if (ffstr_ieq2(&n, &name)) {
-			dbglog("meta requested: %S = %S", &n, &v);
+			// dbglog("meta requested: %S = %S", &n, &v);
 			*val = v;
 			return 0;
 		}
-- 
2.49.0

